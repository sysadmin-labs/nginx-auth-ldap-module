# What this hides, and why.
#
# nginx copies the environment into memory of its own in
# ngx_set_environment() and never gives it back: the block lives as long as
# the process does and is handed to execve() on a binary upgrade.  valgrind
# calls that definitely lost, because at exit nothing points at it any more.
# The stack is nginx's own all the way down:
#
#     malloc
#     ngx_alloc              src/os/unix/ngx_alloc.c:22
#     ngx_set_environment    src/core/nginx.c:591
#     ngx_single_process_cycle
#     main
#
# It shows up only in the single process mode the wrapped driver runs in,
# since the master frees nothing there either way, and no module is on the
# stack.
{
   nginx-set-environment
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:ngx_alloc
   fun:ngx_set_environment
}
