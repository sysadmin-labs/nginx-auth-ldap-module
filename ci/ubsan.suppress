# What this hides, and why.
#
# nginx 1.30.5 calls ngx_memcpy(dst, NULL, 0) from ngx_pstrdup while
# ngx_init_cycle copies the prefix strings -- before a single module is
# loaded.  memcpy is declared __attribute__((nonnull)), so a null source is
# undefined behaviour even when the length is zero and nothing is read or
# written.  The stack is nginx's own all the way down:
#
#     #0 ngx_pstrdup    src/core/ngx_string.c:84
#     #1 ngx_init_cycle src/core/ngx_cycle.c:118
#     #2 main           src/core/nginx.c:293
#
# This module appears in none of those reports, and nginx 1.31.6 does not
# produce them at all.  The entry therefore comes out again as soon as the
# shipped stable line no longer carries it.
nonnull-attribute:ngx_pstrdup

# nginx's own MD5 reads its input four bytes at a time out of a buffer that
# is aligned to one.  That is deliberate: ngx_md5.c takes the unaligned path
# where NGX_HAVE_NONALIGNED says the platform allows it, and x86 does.  The
# module reaches it by hashing a cache key, so the buffer is nginx's and the
# code is nginx's:
#
#     #0 ngx_md5_body   src/core/ngx_md5.c:194
#     #1 ngx_md5_update src/core/ngx_md5.c:36
#
# Nothing the module could do changes it, short of not using nginx's MD5.
alignment:ngx_md5_body

# Only clang's UBSan reads this file; the libubsan of gcc has no
# suppressions option at all.  The workflow therefore filters the same
# finding out of its verdict by hand, and this file stays the one place that
# says which finding it is and why.
