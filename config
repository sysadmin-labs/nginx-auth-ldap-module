ngx_addon_name=ngx_http_auth_ldap_module

LDAP_REQUIRED_LIBS="-lldap"

case "$NGX_PLATFORM" in
    Darwin:*|FreeBSD:*|Linux:*|SunOS:*)
        LDAP_REQUIRED_LIBS="$LDAP_REQUIRED_LIBS -llber"
    ;;
esac

# The library is the prerequisite, so it is checked here rather than at the
# link step.  Where the headers do not sit in the default search path, as on
# FreeBSD, the flags come in through --with-cc-opt and --with-ld-opt.
ngx_feature="OpenLDAP"
ngx_feature_name=
ngx_feature_run=no
ngx_feature_incs="#include <ldap.h>"
ngx_feature_path=
ngx_feature_libs="$LDAP_REQUIRED_LIBS"
ngx_feature_test="LDAP *ld; (void) ldap_initialize(&ld, \"ldap://127.0.0.1\");"
. auto/feature

if [ $ngx_found = no ]; then
    echo
    echo "$0: error: the auth_ldap module requires the OpenLDAP client"
    echo "library.  Install it, or point to it with --with-cc-opt and"
    echo "--with-ld-opt."
    echo
    exit 1
fi

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_auth_ldap_module
    ngx_module_incs=
    ngx_module_deps=
    ngx_module_srcs="$ngx_addon_dir/src/ngx_http_auth_ldap_module.c"
    ngx_module_libs="$LDAP_REQUIRED_LIBS"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_auth_ldap_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/src/ngx_http_auth_ldap_module.c"
    CORE_LIBS="$CORE_LIBS $LDAP_REQUIRED_LIBS"
fi
