# Version and digest pins for every workflow in this repository.
#
# Every workflow takes its versions from here, through
# .github/scripts/pins.sh where a matrix needs them and by sourcing this
# file where a step needs one; ci/build.sh reads it too, so a local build
# verifies what CI verifies.
#
# Version and digest sit on adjacent lines so that they are changed
# together.
#
# The digests pin what is built against: a changed archive, a truncated
# download or a poisoned build cache fails the build.  They say nothing
# about provenance.  nginx.org publishes a detached signature next to each
# archive (nginx-<version>.tar.gz.asc), which this does not check.
#
# Keep KEY=value, no spaces around the equals sign.  The file is sourced by
# ci/build.sh and by the workflow steps that need a version, so a value
# holding more than one word is quoted; .github/scripts/pins.sh strips
# those quotes again when it hands the list to a matrix.
#
# Harvest a new pin, do not guess it:
#     ci/fetch-verify.sh https://nginx.org/download/nginx-1.32.0.tar.gz - /tmp/n.tar.gz

# The releases build-test walks, and nothing older.  nginx keeps the
# current stable and the current mainline alive; everything below 1.30 is
# archive material upstream and no FreeBSD port of this module uses it.
#   1.28.3  last release of the previous stable line, kept as the floor so
#           a newer nginx interface cannot creep in unnoticed
#   1.30.5  what www/nginx, www/nginx-full and www/nginx-lite ship
#   1.31.7  current mainline, what www/nginx-devel ships
NGINX_VERSIONS="1.28.3 1.30.5 1.31.7"
NGINX_1_28_3_SHA256=2c96a946bfb0882a21744ed429770a2123ae1828c7c48665092993ddee91a918
NGINX_1_30_5_SHA256=6c20565aa2325cb82216ae804f4a4ff1875179014759a381c42ddc8e11c4906d
NGINX_1_31_7_SHA256=89ea8a3dc171511f7325043b50e4c036248d9fad5feb7ec809c0b82d5df42c65

# The release every single-version job uses: codeql, lint, sanitizers,
# valgrind and the FreeBSD run.  It is the version the ports ship, so the
# deep checks look at what lands in the package.
NGINX_VERSION=1.30.5

# actionlint checks the workflow definitions, so its archive is pinned like
# a build input.  The digest is the linux_amd64 release archive.
ACTIONLINT_VERSION=1.7.7
ACTIONLINT_SHA256=023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757
